{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/recommend.js": { "includeFiles": "{data,dist}/**", "maxDuration": 60 },
    "api/health.js": { "includeFiles": "dist/**" },
    "api/examples.js": { "includeFiles": "dist/**" },
    "api/agents.js": { "includeFiles": "dist/**" }
  },
  "redirects": [{ "source": "/", "destination": "/ui/", "permanent": false }],
  "rewrites": [{ "source": "/simple", "destination": "/web/index.html" }]
}
